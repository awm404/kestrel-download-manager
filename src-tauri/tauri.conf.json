{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel Download Manager",
  "version": "1.0.0",
  "identifier": "com.kestrel.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kestrel Download Manager",
        "width": 840,
        "height": 570,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "visible": true,
        "focus": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "backgroundColor": [
          10,
          13,
          20,
          255
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kestrel",
    "homepage": "https://github.com/awm404/kestrel-download-manager",
    "copyright": "Copyright (c) 2026 Kestrel contributors",
    "licenseFile": "../LICENSE",
    "shortDescription": "Accessible desktop download manager for aria2",
    "longDescription": "Kestrel is a fast, keyboard- and screen-reader-friendly desktop front end for the aria2 download engine, with HTTP, BitTorrent and magnet support and a companion browser extension.",
    "resources": {
      "../kestrel-extension/": "kestrel-extension/",
      "../engine/dist/kestrel-engine.exe": "kestrel-engine.exe",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../engine/COPYING": "engine-COPYING.txt",
      "../engine/LICENSE.OpenSSL": "engine-LICENSE.OpenSSL.txt",
      "../engine/AUTHORS": "aria2-AUTHORS.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
